# Ejercicio 1: Actualizar valores en diccionarios y listas

# 1. Definición de las estructuras de datos originales proporcionadas en la rúbrica
matriz = [ [10, 15, 20], [3, 7, 14] ]

cantantes = [
    {"nombre": "Ricky Martin", "pais": "Puerto Rico"},
    {"nombre": "Chayanne", "pais": "Puerto Rico"}
]

ciudades = {
    "México": ["Ciudad de México", "Guadalajara", "Cancún"],
    "Chile": ["Santiago", "Concepción", "Viña del Mar"]
}

coordenadas = [
    {"latitud": 8.2588997, "longitud": -84.9399704}
]


# 2. Modificaciones solicitadas:

# a) Cambia el valor de 3 en matriz por 6.
# El número 3 está en la segunda lista (índice 1), primera posición (índice 0).
matriz[1][0] = 6

# b) Cambia el nombre del primer cantante de “Ricky Martin” a “Enrique Martin Morales”.
# Accedemos al primer elemento de la lista (índice 0) y modificamos la clave "nombre".
cantantes[0]["nombre"] = "Enrique Martin Morales"

# c) En ciudades, cambia “Cancún” por “Monterrey”.
# "Cancún" está en la lista de la clave "México", en la tercera posición (índice 2).
ciudades["México"][2] = "Monterrey"

# d) En las coordenadas, cambia el valor de “latitud” por 9.9355431.
# Accedemos al primer diccionario de la lista (índice 0) y modificamos la clave "latitud".
coordenadas[0]["latitud"] = 9.9355431


# 3. Comprobación (Impresión en consola para verificar que los cambios son correctos)
print("--- RESULTADOS EJERCICIO 1 ---")
print("Matriz corregida:", matriz)
print("Cantantes corregido:", cantantes)
print("Ciudades corregidas:", ciudades)
print("Coordenadas corregidas:", coordenadas)
